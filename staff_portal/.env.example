FLASK_SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
# Configure a MySQL database in production, for example:
# DATABASE_URL=mysql+pymysql://sdgnm_user:change-me@localhost:3306/sdgnm
# Local development defaults to a SQLite file in instance/.
DATABASE_URL=
# Required in production: persistent paths outside the source checkout.
# NOTIFICATION_UPLOAD_DIR=
# SIGNING_KEY_DIR=
# Optional if Tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
